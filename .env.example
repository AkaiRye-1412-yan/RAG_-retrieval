# ============================================================
#  AkaiRye 知识RAG平台 配置示例
#  复制为 .env（程序首次启动也会自动生成），填入你自己的密钥。
#  .env 不会被打包进 exe，可随时修改、随时切换模型/Key。
# ============================================================

# ===== 火山方舟 对话模型（OpenAI 兼容接口）=====
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  # 套餐 Key 改用 /api/plan/v3
ARK_MODEL=doubao-seed-1-6-250615
TEMPERATURE=0.7
MAX_TOKENS=4096
# auto | on | off
TOOL_MODE=auto

# ===== 向量模型（留空 KEY/BASE_URL 则回退到 ARK 配置）=====
EMBEDDING_MODEL=doubao-embedding-text-240715
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=2048
EMBEDDING_BATCH=10  # 套餐端点上限 10；标准端点可加大；遇批量上限自动降批

# ===== Tavily 联网搜索（留空则自动禁用联网）=====
TAVILY_API_KEY=
TAVILY_ENABLED=true

# ===== 检索与切分 =====
TOP_K=6
SIMILARITY_THRESHOLD=0.30
CHUNK_SIZE=500
CHUNK_OVERLAP=80
HISTORY_LIMIT=12

# ===== 图片/扫描件离线 OCR =====
OCR_ENABLED=true
OCR_DPI=200

# ===== 路径与性能 =====
DATA_DIR=
VECTOR_CACHE=on
